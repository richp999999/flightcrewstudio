@page "/admin/countries"
@attribute [Authorize(Policy = "Admin")]
@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore
@using FlightCrewStudio.Data
@using FlightCrewStudio.Components.Shared
@using FlightCrewStudio.Services.Admin

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject ReferenceDataImporter Importer
@inject NavigationManager Nav

<PageTitle>Countries · Admin · FlightCrewStudio</PageTitle>

<AdminShell Title="Countries">
<Actions>
    <span class="text-muted">@_rows.Count countries</span>
    <a class="btn btn-primary btn-sm text-white" href="/admin/countries/new">+ Add country</a>
</Actions>
<ChildContent>
    <CsvImportPanel Title="Import countries" OnImport="@(csv => Importer.ImportCountriesAsync(csv))" OnImported="ReloadAsync"
                    Help="Choose an OurAirports countries.csv. Countries are matched on their two-letter code and updated in place; nothing is deleted." />

    <div class="row g-2 mb-3">
        <div class="col-sm-6 col-lg-4">
            <input class="form-control" placeholder="Search code, name or continent" @bind="_search" @bind:event="oninput" />
        </div>
    </div>

    @if (!_loaded) { <p><em>Loading…</em></p> }
    else if (_rows.Count == 0) { <div class="alert alert-info">No countries yet — import a countries.csv above.</div> }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle table-log">
                <thead><tr><th>Code</th><th>Name</th><th>Continent</th><th class="num">Regions</th><th class="num">Airports</th></tr></thead>
                <tbody>
                    @foreach (var r in Filtered)
                    {
                        var id = r.Id;
                        <tr class="clickable-row" @onclick="@(() => Nav.NavigateTo("/admin/countries/" + id))" title="Open country">
                            <td class="fw-bold"><a class="text-reset" href="/admin/countries/@id" @onclick:stopPropagation="true">@r.Code</a></td>
                            <td>@r.Name</td>
                            <td>@Continents.Name(r.Continent)</td>
                            <td class="num">@if (r.Regions > 0) { <a href="/admin/regions?country=@r.Code" @onclick:stopPropagation="true">@r.Regions</a> } else { <span class="text-muted">0</span> }</td>
                            <td class="num">@r.Airports.ToString("N0")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</ChildContent>
</AdminShell>

@code {
    private sealed record Row(int Id, string Code, string Name, string? Continent, int Regions, int Airports);
    private bool _loaded;
    private string _search = "";
    private List<Row> _rows = new();

    private IEnumerable<Row> Filtered
    {
        get
        {
            var q = _search.Trim();
            return q == "" ? _rows : _rows.Where(r => r.Code.Contains(q, StringComparison.OrdinalIgnoreCase)
                || r.Name.Contains(q, StringComparison.OrdinalIgnoreCase)
                || (Continents.Name(r.Continent)?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false));
        }
    }

    protected override Task OnInitializedAsync() => ReloadAsync();

    private async Task ReloadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var regionCounts = await db.Regions.Where(r => r.CountryId != null).GroupBy(r => r.CountryId!.Value)
            .Select(g => new { g.Key, C = g.Count() }).ToDictionaryAsync(x => x.Key, x => x.C);
        var airportCounts = await db.Airports.Where(a => a.CountryId != null).GroupBy(a => a.CountryId!.Value)
            .Select(g => new { g.Key, C = g.Count() }).ToDictionaryAsync(x => x.Key, x => x.C);
        _rows = (await db.Countries.AsNoTracking().OrderBy(c => c.Name).ToListAsync())
            .Select(c => new Row(c.Id, c.Code, c.Name, c.Continent, regionCounts.GetValueOrDefault(c.Id), airportCounts.GetValueOrDefault(c.Id)))
            .ToList();
        _loaded = true;
    }
}
