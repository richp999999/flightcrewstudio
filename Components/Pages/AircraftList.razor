@page "/settings/aircraft"
@page "/aircraft"
@attribute [Authorize]
@rendermode InteractiveServer

@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@using FlightCrewStudio.Data
@using FlightCrewStudio.Components.Shared

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Nav

<PageTitle>Aircraft · FlightCrewStudio</PageTitle>

<SettingsShell>
<div class="page-head">
    <h1>Aircraft</h1>
    <div class="actions">
        <a class="btn btn-primary btn-sm text-white" href="/settings/aircraft/new">+ Add aircraft</a>
    </div>
</div>

@if (!_loaded)
{
    <p><em>Loading…</em></p>
}
else
{
    @if (_aircraft.Count == 0)
    {
        <div class="alert alert-info">No aircraft yet. <a href="/settings/aircraft/new">Add one</a>, or <a href="/import/globalog">import from GlobaLog</a>.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle table-log">
                <thead>
                    <tr>
                        <th>Registration</th>
                        <th>Type</th>
                        <th>Manufacturer</th>
                        <th>Model</th>
                        <th class="num">Flights</th>
                        <th>Last flown</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in _aircraft)
                    {
                        var id = r.Id;
                        <tr class="clickable-row" @onclick="@(() => Nav.NavigateTo("/settings/aircraft/" + id))" title="Open aircraft">
                            <td class="fw-bold"><a class="text-reset" href="/settings/aircraft/@id" @onclick:stopPropagation="true">@r.Display</a></td>
                            <td>@if (r.Type is not null) { <span class="badge badge-soft">@r.Type</span> }</td>
                            <td>@r.Manufacturer</td>
                            <td>@r.Model</td>
                            <td class="num">
                                @if (r.Flights > 0) { <a href="/flights?aircraft=@id" @onclick:stopPropagation="true">@r.Flights</a> } else { <span class="text-muted">0</span> }
                            </td>
                            <td>@(r.LastFlown?.ToString("dd/MM/yyyy") ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

}
</SettingsShell>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private sealed record AircraftRow(int Id, string Display, string? Type, string? Manufacturer, string? Model, int Flights, DateTime? LastFlown);

    private bool _loaded;
    private List<AircraftRow> _aircraft = new();

    protected override async Task OnInitializedAsync()
    {
        var userId = (await AuthState).User.FindFirstValue(ClaimTypes.NameIdentifier)!;
        await using var db = await DbFactory.CreateDbContextAsync();

        var stats = await db.Flights.AsNoTracking()
            .Where(f => f.UserId == userId && f.AircraftId != null)
            .GroupBy(f => f.AircraftId!.Value)
            .Select(g => new { Id = g.Key, Count = g.Count(), Last = g.Max(f => f.OffBlock) })
            .ToDictionaryAsync(x => x.Id);
        var aircraft = await db.Aircraft.AsNoTracking()
            .Include(a => a.IcaoAircraftType).ThenInclude(t => t!.Manufacturer).Where(a => a.UserId == userId).ToListAsync();
        _aircraft = aircraft
            .Select(a => new AircraftRow(a.Id, a.DisplayRegistration,
                a.IcaoAircraftType?.Designator, a.IcaoAircraftType?.Manufacturer?.Code, a.IcaoAircraftType?.Model,
                stats.TryGetValue(a.Id, out var s) ? s.Count : 0,
                stats.TryGetValue(a.Id, out var s2) ? s2.Last : null))
            .OrderByDescending(r => r.Flights).ThenBy(r => r.Display)
            .ToList();
        _loaded = true;
    }
}
