@page "/settings/aircraft/types/new"
@page "/settings/aircraft/types/{Id:int}"
@page "/aircraft/types/new"
@page "/aircraft/types/{Id:int}"
@attribute [Authorize]
@rendermode InteractiveServer

@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@using FlightCrewStudio.Data
@using FlightCrewStudio.Components.Shared

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Nav

<PageTitle>@(IsNew ? "Add aircraft type" : _title) · FlightCrewStudio</PageTitle>

<SettingsShell>
@if (!_loaded)
{
    <p><em>Loading…</em></p>
}
else if (_notFound)
{
    <div class="page-head"><h1>Aircraft type not found</h1></div>
    <a href="/settings/aircraft">« Aircraft</a>
}
else
{
    <div class="page-head">
        <h1>@(IsNew ? "Add aircraft type" : _title)</h1>
        <div class="actions"><a href="/settings/aircraft">« Aircraft</a></div>
    </div>

    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card"><div class="card-body">
                <h5 class="card-title">Type</h5>
                <div class="mb-3">
                    <label class="form-label small">Type / model</label>
                    <input class="form-control" maxlength="50" placeholder="A-321" @bind="_name" />
                </div>
                <div>
                    <label class="form-label small">Manufacturer</label>
                    <input class="form-control text-uppercase" maxlength="50" placeholder="AIRBUS" list="maker-options" @bind="_manufacturer" />
                    <datalist id="maker-options">@foreach (var m in _makers) { <option value="@m" /> }</datalist>
                </div>
                <div class="mt-3">
                    <label class="form-label small">ICAO designator</label>
                    <input class="form-control text-uppercase" maxlength="4" placeholder="@(AircraftType.GuessIcaoCode(_name) ?? "A21N")" @bind="_icao" />
                    <div class="form-text">Printed as the aircraft model in logbook exports. Leave blank to use @(AircraftType.GuessIcaoCode(_name) is { } g ? $"“{g}” (worked out from the type name)" : "the type name").</div>
                </div>
            </div></div>
        </div>

        @if (!IsNew)
        {
            <div class="col-lg-6">
                <div class="card"><div class="card-body">
                    <h5 class="card-title">Aircraft of this type</h5>
                    @if (_aircraft.Count == 0)
                    {
                        <p class="text-muted mb-0">None.</p>
                    }
                    else
                    {
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var a in _aircraft) { <a class="badge badge-soft fs-6" href="/settings/aircraft/@a.Id">@a.DisplayRegistration</a> }
                        </div>
                    }
                </div></div>
            </div>
        }
    </div>

    <div class="save-bar">
        @if (!string.IsNullOrEmpty(_status))
        {
            <span class="@(_statusOk ? "text-success" : "text-danger") me-auto">@_status</span>
        }
        @if (!IsNew)
        {
            @if (_aircraft.Count == 0)
            {
                @if (_confirmDelete)
                {
                    <span class="me-1">Remove this type?</span>
                    <button class="btn btn-danger" @onclick="DeleteAsync" disabled="@_busy">Remove</button>
                    <button class="btn btn-outline-secondary" @onclick="() => _confirmDelete = false">Cancel</button>
                }
                else
                {
                    <button class="btn btn-outline-danger me-auto" @onclick="() => _confirmDelete = true">Remove type</button>
                }
            }
            else
            {
                <span class="small-muted me-auto">Used by @_aircraft.Count aircraft, so it can't be removed.</span>
            }
        }
        <a class="btn btn-outline-secondary" href="/settings/aircraft">Cancel</a>
        <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_busy">@(IsNew ? "Add type" : "Save")</button>
    </div>
}
</SettingsShell>

@code {
    [Parameter] public int? Id { get; set; }
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private bool IsNew => Id is null;
    private bool _loaded, _notFound, _busy, _statusOk, _confirmDelete;
    private string? _status, _name, _manufacturer, _title, _icao;
    private string _userId = default!;
    private List<Aircraft> _aircraft = new();
    private List<string> _makers = new();

    protected override async Task OnParametersSetAsync()
    {
        _userId = (await AuthState).User.FindFirstValue(ClaimTypes.NameIdentifier)!;
        await using var db = await DbFactory.CreateDbContextAsync();
        _makers = (await db.AircraftTypes.AsNoTracking().Where(t => t.UserId == _userId && t.Manufacturer != null)
            .Select(t => t.Manufacturer!).Distinct().ToListAsync()).Order().ToList();

        if (!IsNew)
        {
            var t = await db.AircraftTypes.AsNoTracking().FirstOrDefaultAsync(x => x.Id == Id && x.UserId == _userId);
            if (t is null) { _notFound = true; _loaded = true; return; }
            _name = t.Name; _manufacturer = t.Manufacturer; _title = t.DisplayName; _icao = t.IcaoCode;
            _aircraft = (await db.Aircraft.AsNoTracking().Where(a => a.AircraftTypeId == Id).ToListAsync())
                .OrderBy(a => a.Registration).ToList();
        }
        _loaded = true;
    }

    private async Task SaveAsync()
    {
        _busy = true; _status = null;
        try
        {
            var name = string.IsNullOrWhiteSpace(_name) ? null : _name.Trim();
            if (name is null) { _statusOk = false; _status = "Enter a type name."; return; }
            var maker = string.IsNullOrWhiteSpace(_manufacturer) ? null : _manufacturer.Trim().ToUpperInvariant();

            await using var db = await DbFactory.CreateDbContextAsync();
            if (await db.AircraftTypes.AnyAsync(t => t.UserId == _userId && t.Name == name && t.Id != (Id ?? 0)))
            { _statusOk = false; _status = $"A type called {name} already exists."; return; }

            AircraftType type;
            if (IsNew)
            {
                type = new AircraftType { UserId = _userId };
                db.AircraftTypes.Add(type);
            }
            else
            {
                type = await db.AircraftTypes.FirstAsync(t => t.Id == Id && t.UserId == _userId);
            }
            type.Name = name;
            type.Manufacturer = maker;
            type.IcaoCode = string.IsNullOrWhiteSpace(_icao) ? null : _icao.Trim().ToUpperInvariant();
            await db.SaveChangesAsync();

            if (IsNew) { Nav.NavigateTo($"/settings/aircraft/types/{type.Id}"); return; }
            _title = type.DisplayName; _manufacturer = maker; _icao = type.IcaoCode;
            _statusOk = true; _status = "Saved.";
        }
        catch (Exception ex) { _statusOk = false; _status = $"Could not save: {ex.Message}"; }
        finally { _busy = false; }
    }

    private async Task DeleteAsync()
    {
        _busy = true; _status = null;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var t = await db.AircraftTypes.FirstOrDefaultAsync(x => x.Id == Id && x.UserId == _userId);
            if (t is null) { Nav.NavigateTo("/settings/aircraft"); return; }
            if (await db.Aircraft.AnyAsync(a => a.AircraftTypeId == Id))
            { _statusOk = false; _status = "This type is used by aircraft and can't be removed."; _confirmDelete = false; return; }
            db.AircraftTypes.Remove(t);
            await db.SaveChangesAsync();
            Nav.NavigateTo("/settings/aircraft");
        }
        catch (Exception ex) { _statusOk = false; _status = $"Could not remove: {ex.Message}"; }
        finally { _busy = false; }
    }
}
