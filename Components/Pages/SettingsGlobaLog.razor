@page "/settings/globalog"
@attribute [Authorize]
@rendermode InteractiveServer

@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@using FlightCrewStudio.Data
@using FlightCrewStudio.Components.Shared
@using FlightCrewStudio.Services
@using FlightCrewStudio.Services.GlobaLog

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject ICredentialProtector Protector
@inject IGlobaLogClientFactory ClientFactory

<PageTitle>GlobaLog settings</PageTitle>

<SettingsShell>
<div class="page-head"><h1>GlobaLog</h1></div>
<p class="text-muted">
    Your GlobaLog credentials are encrypted with a key held on the server before being stored —
    the database only ever contains the ciphertext.
</p>

@if (!_loaded)
{
    <p><em>Loading…</em></p>
}
else
{
    <div class="row">
        <div class="col-xl-7">
            <div class="mb-3">
                <label class="form-label fw-bold">Authentication method</label>
                <div class="form-check">
                    <input class="form-check-input" type="radio" id="modeWeb" name="authmode"
                           checked="@(_authMode == GlobaLogAuthMode.WebSession)"
                           @onchange="@(() => _authMode = GlobaLogAuthMode.WebSession)" />
                    <label class="form-check-label" for="modeWeb">
                        Username &amp; password <span class="text-muted">(logs in to GlobaLog's website and downloads your logbook export)</span>
                    </label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" id="modeToken" name="authmode"
                           checked="@(_authMode == GlobaLogAuthMode.ApiToken)"
                           @onchange="@(() => _authMode = GlobaLogAuthMode.ApiToken)" />
                    <label class="form-check-label" for="modeToken">
                        API token <span class="text-muted">(X-Token — operator-issued; most crew accounts won't have one)</span>
                    </label>
                </div>
            </div>

            @if (_authMode == GlobaLogAuthMode.WebSession)
            {
                <div class="mb-3">
                    <label for="user" class="form-label">GlobaLog username</label>
                    <input id="user" class="form-control" @bind="_username" autocomplete="off" />
                </div>
                <div class="mb-3">
                    <label for="pass" class="form-label">GlobaLog password</label>
                    <input id="pass" type="password" class="form-control" @bind="_password"
                           placeholder="@(_hasPassword ? "•••••• (leave blank to keep current)" : "")" autocomplete="off" />
                </div>
            }
            else
            {
                <div class="mb-3">
                    <label for="token" class="form-label">GlobaLog API token (X-Token)</label>
                    <input id="token" type="password" class="form-control" @bind="_apiToken"
                           placeholder="@(_hasToken ? "•••••• (leave blank to keep current)" : "")" autocomplete="off" />
                </div>
            }

            <div class="d-flex gap-2">
                <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_busy">Save</button>
                <button class="btn btn-outline-secondary" @onclick="TestAsync" disabled="@_busy">Test connection</button>
            </div>

            @if (!string.IsNullOrEmpty(_status))
            {
                <div class="alert @(_statusOk ? "alert-success" : "alert-danger") mt-3" role="alert">@_status</div>
            }
        </div>
    </div>
}
</SettingsShell>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private bool _loaded;
    private bool _busy;
    private string? _userId;

    private GlobaLogAuthMode _authMode = GlobaLogAuthMode.WebSession;
    private string? _username;
    private string? _password;
    private string? _apiToken;
    private bool _hasPassword;
    private bool _hasToken;

    private string? _status;
    private bool _statusOk;

    protected override async Task OnInitializedAsync()
    {
        _userId = (await AuthState).User.FindFirstValue(ClaimTypes.NameIdentifier);
        await using var db = await DbFactory.CreateDbContextAsync();
        var cred = await db.GlobaLogCredentials.AsNoTracking().FirstOrDefaultAsync(c => c.UserId == _userId);
        if (cred is not null)
        {
            _authMode = cred.AuthMode;
            _username = Protector.Unprotect(cred.UsernameCipher);
            _hasPassword = !string.IsNullOrEmpty(cred.PasswordCipher);
            _hasToken = !string.IsNullOrEmpty(cred.ApiTokenCipher);
        }
        _loaded = true;
    }

    private async Task<GlobaLogCredential> LoadOrCreateAsync(ApplicationDbContext db)
    {
        var cred = await db.GlobaLogCredentials.FirstOrDefaultAsync(c => c.UserId == _userId);
        if (cred is null)
        {
            cred = new GlobaLogCredential { UserId = _userId! };
            db.GlobaLogCredentials.Add(cred);
        }
        return cred;
    }

    private async Task SaveAsync()
    {
        _busy = true; _status = null;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var cred = await LoadOrCreateAsync(db);
            cred.AuthMode = _authMode;

            if (_authMode == GlobaLogAuthMode.WebSession)
            {
                cred.UsernameCipher = Protector.Protect(_username);
                if (!string.IsNullOrEmpty(_password))
                    cred.PasswordCipher = Protector.Protect(_password);
            }
            else
            {
                if (!string.IsNullOrEmpty(_apiToken))
                    cred.ApiTokenCipher = Protector.Protect(_apiToken);
            }

            cred.UpdatedAt = DateTime.UtcNow;
            await db.SaveChangesAsync();

            _password = null; _apiToken = null;
            _hasPassword = !string.IsNullOrEmpty(cred.PasswordCipher);
            _hasToken = !string.IsNullOrEmpty(cred.ApiTokenCipher);
            _statusOk = true;
            _status = "Settings saved.";
        }
        catch (Exception ex)
        {
            _statusOk = false; _status = $"Could not save: {ex.Message}";
        }
        finally { _busy = false; }
    }

    private async Task TestAsync()
    {
        _busy = true; _status = null;
        try
        {
            // Save first so the test uses what's on screen.
            await SaveAsync();
            await using var db = await DbFactory.CreateDbContextAsync();
            var cred = await db.GlobaLogCredentials.AsNoTracking().FirstAsync(c => c.UserId == _userId);
            using var client = ClientFactory.Create(cred);
            var hello = await client.TestConnectionAsync();
            _statusOk = true;
            _status = $"Connected to GlobaLog as {hello.YourName ?? "(unknown)"} — operator {hello.Operator ?? "(unknown)"}.";
        }
        catch (Exception ex)
        {
            _statusOk = false; _status = $"Connection failed: {ex.Message}";
        }
        finally { _busy = false; }
    }
}
